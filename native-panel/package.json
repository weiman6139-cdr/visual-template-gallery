{
  "name": "visual-template-gallery",
  "version": "0.2.14",
  "private": true,
  "type": "module",
  "description": "Codex MCP App plugin for visual template selection and conversation reference context.",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-plugin.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "mcp": "tsx src/mcp/server.ts",
    "test:app-host": "tsx scripts/test-mcp-host.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "prune": "node scripts/prune.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  }
}
